# syntax=docker/dockerfile:1

# Bun 1.4.4 — origem fixada por digest.
FROM oven/bun:1.4.4@sha256:1d22548f177f4ff38e0c15baa3c2c46c6c2060ba2d1bc573bb4720b407548f1d AS bun-source

# Imagem Android original, preservada.
FROM app-react-native-android-ci:36-jdk17-bun1.3.14-v3

# Substituir somente o executável do Bun.
COPY --from=bun-source /usr/local/bin/bun /opt/bun/bin/bun

# Garantias de integridade e runtime.
RUN set -eu; \
    printf '%s  %s\n' \
      '10702245766b225e70bbf6235fd6b47214fd94b4760d00ffaed8ab0df57ac235' \
      '/opt/bun/bin/bun' | sha256sum -c -; \
    test "$(bun --version)" = "1.4.4"; \
    test "$(node --version)" = "v22.23.3"; \
    test "$(readlink -f "$(command -v bun)")" = "/opt/bun/bin/bun"
