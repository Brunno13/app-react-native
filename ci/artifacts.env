GARAGE_REGION=us-east-1
GARAGE_BUCKET=app-react-native-builds
GARAGE_ANDROID_PREFIX=android
GARAGE_IOS_PREFIX=ios
ARTIFACT_BASENAME=app-react-native

# ============================================================
# APP IDENTITY
# ============================================================

APP_DISPLAY_NAME="App Bun"
APP_STAGING_NAME_SUFFIX=" (staging)"

ANDROID_APPLICATION_ID=com.brunno.app
IOS_BUNDLE_IDENTIFIER=com.brunno.app

APP_STAGING_ID_SUFFIX=.staging

APP_SCHEME=app-react-native
